{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemPanel",
  "version": "0.1.0",
  "identifier": "dev.systempanel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "SystemPanel",
      "width": 400,
      "height": 660,
      "resizable": false,
      "fullscreen": false,
      "decorations": false,
      "transparent": true,
      "backgroundColor": "#00000000",
      "windowEffects": {
        "effects": ["hudWindow", "acrylic"],
        "state": "active",
        "radius": 16,
        "color": [8, 10, 14, 190]
      },
      "visible": false,
      "skipTaskbar": true,
      "alwaysOnTop": true,
      "shadow": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "菜单栏里的本地系统看板",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "infoPlist": "Info.plist" },
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } }
  }
}
